# Anthropic Claude API key used by DoneFlow AI categorization service.
ANTHROPIC_API_KEY=sk-ant-api-key-here

# SQLAlchemy database URL (SQLite for local development by default).
DATABASE_URL=sqlite:///doneflow.db

# Application environment: development | staging | production | test
APP_ENV=development

# Logging verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Timeout (seconds) for AI categorization API calls.
AI_TIMEOUT_SECONDS=2

# Cache TTL (seconds) for AI categorization responses.
AI_CACHE_TTL_SECONDS=300
